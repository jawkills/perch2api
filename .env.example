# Perch2API configuration. Every value has a working default, so an empty file is
# valid. Copy to `.env` (gitignored); real environment variables win over the file.

# -- Listen -------------------------------------------------------------------
HOST=127.0.0.1
PORT=8790

# Bearer key clients must send. Empty = no auth (loopback only).
PERCH2API_KEY=change-me

# -- Upstream -----------------------------------------------------------------
PERCH_APP_URL=https://app.perchai.app
PERCH_CLI_VERSION=2.4.118
PERCH_LOCALE=en
PERCH_CLIENT_SURFACE=cli

# -- Session discovery --------------------------------------------------------
# Directory holding cli-auth-session.json (overrides the built-in candidates).
# PERCH_CLI_AUTH_DIR=C:/Users/<you>/AppData/Roaming/Perch AI Desktop
# Extra session files for multi-account rotation.
# PERCH_SESSION_FILES=accounts/acc1.json,accounts/acc2.json

# -- Behaviour ----------------------------------------------------------------
# The surface gate needs Perch's own operator preamble. It is not shipped here:
# run `node scripts/extract-prefix.mjs` (writes .perch-prefix.txt) or set this.
# PERCH_SYSTEM_PREFIX=You are ...
# prepend = satisfy the upstream surface gate with that prefix.
PERCH_SYSTEM_PREFIX_MODE=prepend
# code = persona-free (Perch only enforces its Saffron operator prompt on the
# chat/worker lanes). Use chat for full agent behaviour with the Perch persona.
PERCH_LANE=code
# Appended after the gate prefix when the caller sends no system prompt.
# PERCH_NEUTRAL_SYSTEM=You are a helpful assistant.
PERCH_TIMEOUT_MS=180000
PERCH_MAX_RETRIES=2
PERCH_EXPOSE_REASONING=true
PERCH_DISABLE_THINKING=false
PERCH2API_LOG=true
